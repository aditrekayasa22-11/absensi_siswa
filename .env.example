# ==========================================================
#  KONFIGURASI APLIKASI - PRESENSICU
#  Salin file ini menjadi .env lalu sesuaikan nilainya.
#  JANGAN COMMIT FILE .env KE REPOSITORY PUBLIK.
# ==========================================================

APP_NAME="PresensiKu"
# Kosongkan untuk deteksi otomatis, atau isi mis. http://localhost/absensi_siswa
APP_URL=
APP_TIMEZONE="Asia/Jakarta"
APP_DEBUG=true

# Database MySQL / MariaDB (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=absensi_siswa
DB_USER=root
DB_PASS=

# ----------------------------------------------------------
# FONNTE (WhatsApp Gateway)
# ----------------------------------------------------------
# Isi token dari dashboard Fonnte: https://fonnte.com
# Selama FONNTE_ENABLED=false, pesan hanya dicatat sebagai
# "simulasi" dan TIDAK dikirim ke WhatsApp.
FONNTE_ENABLED=false
FONNTE_TOKEN=
FONNTE_COUNTRY_CODE=62

# Nomor WhatsApp admin untuk menerima notifikasi
# Format: 628xxxxxxxxxx (tanpa + dan tanpa spasi)
ADMIN_WA=6281234567890

# API key internal untuk endpoint api/send_wa.php
# Buat string acak panjang, contoh: openssl rand -hex 32
API_KEY=ganti-dengan-kunci-acak-yang-panjang

# Batas jam masuk (lebih dari jam ini = TERLAMBAT)
JAM_MASUK_BATAS=07:30
